# このファイルを .env という名前でコピーして値を入れる（.env は Git に入らない）

# Discord: 投稿先チャンネルの設定 → 連携サービス → ウェブフック → 新しいウェブフック → 「ウェブフック URL をコピー」
DISCORD_WEBHOOK_URL=

# Rust+: `npx --yes @liamcottle/rustplus.js fcm-register` で Steam ログインすると rustplus.config.json ができる。
#   fcm_credentials.gcm.androidId     → GCM_ANDROID_ID
#   fcm_credentials.gcm.securityToken → GCM_SECURITY_TOKEN
# （README の方法 B なら gcm_android_id / gcm_security_token の値）。他人に見せない
GCM_ANDROID_ID=
GCM_SECURITY_TOKEN=

# 任意: アラーム投稿に付けるメンション。例: @here / <@&ロールID> / <@ユーザーID>
ALARM_MENTION=

# 任意: オフライン中に倒されたときの通知を転送する（true / false）
FORWARD_DEATH=false

# 任意: チームメイトのログイン通知を転送する（true / false）
FORWARD_TEAM_LOGIN=false

# 任意: 受信済み通知とサーバー名の記録先
STATE_FILE=state.json

# 任意: アラームの題名ごとの振り分け設定の置き場（秘密の値は入らない）
SETTINGS_FILE=settings.json
