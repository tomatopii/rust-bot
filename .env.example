# このファイルを .env という名前でコピーして値を入れる（.env は Git に入らない）

# Discord: 投稿先チャンネルの設定 → 連携サービス → ウェブフック → 新しいウェブフック → 「ウェブフック URL をコピー」
DISCORD_WEBHOOK_URL=

# Rust+: https://rustplusplus-credentials.netlify.app/ で Steam ログインすると
#   /credentials add gcm_android_id:XXXX gcm_security_token:YYYY steam_id:... issued_date:... expire_date:...
# と表示される。XXXX を GCM_ANDROID_ID、YYYY を GCM_SECURITY_TOKEN に貼る。他人に見せない
GCM_ANDROID_ID=
GCM_SECURITY_TOKEN=

# 任意: アラーム投稿に付けるメンション。例: @here / <@&ロールID> / <@ユーザーID>
ALARM_MENTION=

# 任意: オフライン中に倒されたときの通知を転送する（true / false）
FORWARD_DEATH=false

# 任意: チームメイトのログイン通知を転送する（true / false）
FORWARD_TEAM_LOGIN=false

# 任意: 受信済み通知とサーバー名の記録先
STATE_FILE=state.json
